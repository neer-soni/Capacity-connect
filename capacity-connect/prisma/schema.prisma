generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────
model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  username        String   @unique
  passwordHash    String
  role            String   @default("trainee") // trainee | trainer | admin
  status          String   @default("pending") // pending | approved | suspended
  department      String   @default("")
  designation     String   @default("")
  skills          String   @default("[]") // JSON array of skill strings
  bio             String   @default("")
  avatar          String   @default("")
  publicPortfolio Boolean  @default(true)
  verified        Boolean  @default(false) // trainer verification
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courses           Course[]          @relation("TrainerCourses")
  enrollments       Enrollment[]
  attempts          Attempt[]
  certificates      Certificate[]
  threads           ForumThread[]
  replies           ForumReply[]
  notifications     Notification[]
  reports           Report[]          @relation("ReportedByUser")
  auditLogs         AuditLog[]
  announcements     Announcement[]
  competencies      CompetencyMap[]
  resources         Resource[]
  lessonProgress    LessonProgress[]
  userCompetencies  UserCompetency[]
}

// ─── Courses ─────────────────────────────────────────────────────
model Course {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  description       String
  trainerId         String
  department        String   @default("")
  tags              String   @default("[]") // JSON array
  status            String   @default("draft") // draft | pending_review | approved | published | rejected
  duration          String   @default("")
  estimatedMinutes  Int      @default(0)
  level             String   @default("Beginner") // Beginner | Intermediate | Advanced
  thumbnail         String   @default("📚")
  totalLessons      Int      @default(0)
  objectives        String   @default("[]") // JSON array of strings
  rejectionReason   String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainer      User               @relation("TrainerCourses", fields: [trainerId], references: [id])
  enrollments  Enrollment[]
  resources    Resource[]
  lessons      Lesson[]
  assessments  Assessment[]
  certificates Certificate[]
  threads      ForumThread[]
  feedback     Feedback[]
  competencies CourseCompetency[]
}

// ─── Lessons ─────────────────────────────────────────────────────
model Lesson {
  id                   String   @id @default(cuid())
  courseId             String
  title                String
  description          String   @default("")
  type                 String   @default("video") // video | pdf | slide | text
  order                Int      @default(0)
  videoUrl             String   @default("")
  videoDurationSeconds Int      @default(0)
  resourceUrl          String   @default("")
  size                 String   @default("")
  isRequired           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
}

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  lessonId       String
  watchedSeconds Float    @default(0)
  duration       Float    @default(0)
  percentage     Float    @default(0)
  completed      Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

// ─── Enrollments ─────────────────────────────────────────────────
model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Int       @default(0) // 0-100, server-calculated
  status      String    @default("in_progress") // in_progress | completed
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// ─── Resources (legacy / extra files; lessons are primary content) ─
model Resource {
  id         String @id @default(cuid())
  courseId   String
  type       String // video | pdf | slide
  title      String
  url        String @default("")
  size       String @default("")
  duration   String @default("")
  uploadedBy String

  course   Course @relation(fields: [courseId], references: [id])
  uploader User   @relation(fields: [uploadedBy], references: [id])
}

// ─── Assessments / Quizzes ───────────────────────────────────────
model Assessment {
  id            String    @id @default(cuid())
  courseId      String
  title         String
  deadline      DateTime?
  timeLimit     Int       @default(30) // minutes
  passingScore  Int       @default(60) // percentage
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]
}

model Question {
  id              String @id @default(cuid())
  assessmentId    String
  text            String
  correctOptionId String @default("")
  marks           Int    @default(1)
  order           Int    @default(0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    Option[]
}

model Option {
  id         String @id @default(cuid())
  questionId String
  text       String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id           String   @id @default(cuid())
  assessmentId String
  userId       String
  score        Int      @default(0)
  total        Int      @default(0)
  percentage   Int      @default(0)
  passed       Boolean  @default(false)
  answers      String   @default("{}") // JSON: { questionId: selectedOptionId }
  submittedAt  DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}

// ─── Certificates ────────────────────────────────────────────────
model Certificate {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  hash             String   @unique @default(cuid())
  validatedByAdmin Boolean  @default(false)
  issuedAt         DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// ─── Forum ───────────────────────────────────────────────────────
model ForumThread {
  id             String   @id @default(cuid())
  courseId       String
  authorId       String
  title          String
  body           String
  isQuestion     Boolean  @default(false)
  acceptedReplyId String?
  upvotes        Int      @default(0)
  createdAt      DateTime @default(now())

  course  Course       @relation(fields: [courseId], references: [id])
  author  User         @relation(fields: [authorId], references: [id])
  replies ForumReply[]
}

model ForumReply {
  id            String   @id @default(cuid())
  threadId      String
  parentReplyId String?
  authorId      String
  body          String
  upvotes       Int      @default(0)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id])
}

// ─── Feedback ────────────────────────────────────────────────────
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int      @default(5)
  comment   String   @default("")
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// ─── Notifications ───────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Reports / Moderation ────────────────────────────────────────
model Report {
  id             String   @id @default(cuid())
  contentType    String
  contentId      String
  reportedBy     String
  reportedUser   String   @default("")
  reason         String
  status         String   @default("pending") // pending | resolved | dismissed
  resolvedAction String   @default("")
  courseContext  String   @default("")
  createdAt      DateTime @default(now())

  reporter User @relation("ReportedByUser", fields: [reportedBy], references: [id])
}

// ─── Competency catalog ──────────────────────────────────────────
model Competency {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")
  category    String @default("")

  courses CourseCompetency[]
  users   UserCompetency[]
}

model CourseCompetency {
  id            String @id @default(cuid())
  courseId      String
  competencyId  String
  targetLevel   Int    @default(3)

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency  Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([courseId, competencyId])
}

model UserCompetency {
  id             String    @id @default(cuid())
  userId         String
  competencyId   String
  currentLevel   Int       @default(0)
  targetLevel    Int       @default(3)
  evidence       String    @default("")
  lastAssessedAt DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency  Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([userId, competencyId])
}

// Trainer verified skills (existing mapping)
model CompetencyMap {
  id              String  @id @default(cuid())
  trainerId       String
  skillTag        String
  verifiedByAdmin Boolean @default(false)

  trainer User @relation(fields: [trainerId], references: [id])

  @@unique([trainerId, skillTag])
}

// ─── Audit Log ───────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String   @default("")
  details   String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Announcements (Homepage) ────────────────────────────────────
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  type        String   @default("announcement")
  icon        String   @default("📢")
  publishedBy String
  createdAt   DateTime @default(now())

  publisher User @relation(fields: [publishedBy], references: [id])
}
